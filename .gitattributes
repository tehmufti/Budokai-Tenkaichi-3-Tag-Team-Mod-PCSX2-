* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bin binary
*.pnach -text
*.png binary
